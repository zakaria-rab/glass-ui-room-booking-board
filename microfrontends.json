{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "glass-ui-framework": {
      "development": {
        "fallback": "glass-ui-framework.vercel.app"
      }
    },
    "glass-ui-room-booking-board": {
      "routing": [
        {
          "group": "apps",
          "paths": [
            "/apps/room-booking-board",
            "/apps/room-booking-board/:path*"
          ]
        }
      ]
    }
  }
}
